<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Module chip on the results screen -->
    <style name="Widget.Awesome.ModuleChip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/chip_background</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="rippleColor">@color/brand_blue_tint</item>
        <item name="iconSize">10dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/chip_dot</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>

    <!-- Bottom navigation chip -->
    <style name="Widget.Awesome.NavChip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/nav_chip_background</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/brand_blue_tint</item>
        <item name="iconSize">20dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/nav_chip_icon</item>
        <item name="android:textColor">@color/nav_chip_text</item>
    </style>

    <style name="Widget.Awesome.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@drawable/bg_snackbar</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">6dp</item>
        <item name="android:layout_margin">16dp</item>
    </style>

    <style name="Widget.Awesome.Snackbar.TextView" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>